// 产品类型配置
type MarketCategory {
	id           int64  `json:"id"`
	categoryType int64  `json:"categoryType"`
	categoryCode string `json:"categoryCode"`
	categoryName string `json:"categoryName"`
	enabled      int64  `json:"enabled"`
	appVisible   int64  `json:"appVisible"`
	syncPriority int64  `json:"syncPriority"`
	sort         int64  `json:"sort"`
	icon         string `json:"icon"`
	remark       string `json:"remark"`
	createTimes  int64  `json:"createTimes"`
	updateTimes  int64  `json:"updateTimes"`
}

// 产品
type MarketProduct {
	id           int64  `json:"id"`
	categoryType int64  `json:"categoryType"`
	categoryCode string `json:"categoryCode"`
	categoryName string `json:"categoryName"`
	market       string `json:"market"` //
	symbol       string `json:"symbol"` //
	code         string `json:"code"` // 第三方原始 code
	name         string `json:"name"`
	displayName  string `json:"displayName"`
	baseCoin     string `json:"baseCoin"`
	quoteCoin    string `json:"quoteCoin"`
	enabled      int64  `json:"enabled"`
	appVisible   int64  `json:"appVisible"`
	syncPriority int64  `json:"syncPriority"`
	sort         int64  `json:"sort"`
	icon         string `json:"icon"`
	remark       string `json:"remark"`
	createTimes  int64  `json:"createTimes"`
	updateTimes  int64  `json:"updateTimes"`
}

// K线
type Kline {
	categoryCode string `json:"categoryCode"`
	market       string `json:"market"`
	symbol       string `json:"symbol"`
	kType        int64  `json:"kType"`
	ts           int64  `json:"ts"`
	open         string `json:"open"`
	high         string `json:"high"`
	low          string `json:"low"`
	close        string `json:"close"`
	volume       string `json:"volume"`
	turnover     string `json:"turnover"`
}

// 深度档位
type DepthLevel {
	price  string `json:"price"`
	volume string `json:"volume"`
}

// 深度
type Depth {
	market string       `json:"market"`
	symbol string       `json:"symbol"`
	asks   []DepthLevel `json:"asks"`
	bids   []DepthLevel `json:"bids"`
	ts     int64        `json:"ts"`
}

// 实时报价
type Quote {
	market         string `json:"market"`
	symbol         string `json:"symbol"`
	lastPrice      string `json:"lastPrice"`
	openPrice      string `json:"openPrice"`
	highPrice      string `json:"highPrice"`
	lowPrice       string `json:"lowPrice"`
	prevClosePrice string `json:"prevClosePrice"`
	changeValue    string `json:"changeValue"`
	changeRate     string `json:"changeRate"`
	volume         string `json:"volume"`
	turnover       string `json:"turnover"`
	quoteTs        int64  `json:"quoteTs"`
	tradeStatus    int64  `json:"tradeStatus"`
}

type MarketTenantCategory {
	id          int64  `json:"id"`
	tenantId    int64  `json:"tenantId"`
	categoryId  int64  `json:"categoryId"`
	enabled     int64  `json:"enabled"`
	appVisible  int64  `json:"appVisible"`
	sort        int64  `json:"sort"`
	remark      string `json:"remark"`
	createTimes int64  `json:"createTimes"`
	updateTimes int64  `json:"updateTimes"`
	// 冗余返回字段，方便前端展示
	categoryType int64  `json:"categoryType"`
	categoryName string `json:"categoryName"`
	icon         string `json:"icon"`
	tenantName   string `json:"tenantName"`
}

type MarketTenantProduct {
	id          int64  `json:"id"`
	tenantId    int64  `json:"tenantId"`
	productId   int64  `json:"productId"`
	enabled     int64  `json:"enabled"`
	appVisible  int64  `json:"appVisible"`
	sort        int64  `json:"sort"`
	remark      string `json:"remark"`
	createTimes int64  `json:"createTimes"`
	updateTimes int64  `json:"updateTimes"`
	// 冗余返回字段，方便前端展示
	categoryType int64  `json:"categoryType"`
	categoryName string `json:"categoryName"`
	market       string `json:"market"`
	symbol       string `json:"symbol"`
	code         string `json:"code"`
	name         string `json:"name"`
	displayName  string `json:"displayName"`
	baseCoin     string `json:"baseCoin"`
	quoteCoin    string `json:"quoteCoin"`
	icon         string `json:"icon"`
	tenantName   string `json:"tenantName"`
}

// ====================
// 产品类型
// ====================
type CreateCategoryReq {
	categoryType int64  `json:"categoryType"`
	categoryName string `json:"categoryName"`
	enabled      int64  `json:"enabled"`
	appVisible   int64  `json:"appVisible"`
	syncPriority int64  `json:"syncPriority"`
	sort         int64  `json:"sort"`
	icon         string `json:"icon"`
	remark       string `json:"remark"`
}

type UpdateCategoryReq {
	id           int64  `json:"id"`
	categoryName string `json:"categoryName"`
	enabled      int64  `json:"enabled"`
	appVisible   int64  `json:"appVisible"`
	syncPriority int64  `json:"syncPriority"`
	sort         int64  `json:"sort"`
	icon         string `json:"icon"`
	remark       string `json:"remark"`
}

type GetCategoryReq {
	id int64 `path:"id"`
}

type GetCategoryResp {
	RespBase
	data MarketCategory `json:"data"`
}

type ListCategoriesReq {
	PageReq
	categoryType int64 `json:"categoryType,optional"`
	enabled      int32 `json:"enabled,optional"` // 0全部 1启用 2禁用
	appVisible   int32 `json:"appVisible,optional"`
}

type ListCategoriesResp {
	RespBase
	data []MarketCategory `json:"data"`
}

type SyncCategoryProductsReq {
	id int64 `json:"id"`
}

type SyncCategoryProductsResp {
	RespBase
	data string `json:"data"`
}

type GetSyncTaskStatusReq {
	taskNo string `json:"taskNo"`
}

type GetSyncTaskStatusData {
	taskNo  string `json:"taskNo"`
	status  int32  `json:"status"` // 0进行中 1成功 2失败
	message string `json:"message"`
}

type GetSyncTaskStatusResp {
	RespBase
	data GetSyncTaskStatusData `json:"data"`
}

// ====================
// 产品
// ====================
type CreateProductReq {
	categoryType int64  `json:"categoryType"`
	market       string `json:"market"`
	symbol       string `json:"symbol"`
	code         string `json:"code"`
	name         string `json:"name"`
	displayName  string `json:"displayName"`
	baseCoin     string `json:"baseCoin"`
	quoteCoin    string `json:"quoteCoin"`
	enabled      int64  `json:"enabled"`
	appVisible   int64  `json:"appVisible"`
	syncPriority int64  `json:"syncPriority"`
	sort         int64  `json:"sort"`
	icon         string `json:"icon"`
	remark       string `json:"remark"`
}

type UpdateProductReq {
	id           int64  `json:"id"`
	name         string `json:"name"`
	displayName  string `json:"displayName"`
	baseCoin     string `json:"baseCoin"`
	quoteCoin    string `json:"quoteCoin"`
	enabled      int64  `json:"enabled"`
	appVisible   int64  `json:"appVisible"`
	syncPriority int64  `json:"syncPriority"`
	sort         int64  `json:"sort"`
	icon         string `json:"icon"`
	remark       string `json:"remark"`
}

type GetProductReq {
	id int64 `path:"id"`
}

type GetProductResp {
	RespBase
	data MarketProduct `json:"data"`
}

type ListProductsReq {
	PageReq
	categoryType int64  `form:"categoryType,optional"`
	categoryName string `form:"categoryName,optional"`
	market       string `form:"market,optional"`
	keyword      string `form:"keyword,optional"`
	enabled      int32  `form:"enabled,optional"` // 0全部 1启用 2禁用
	appVisible   int32  `form:"appVisible,optional"` // 0全部 1显示 2隐藏
	symbol       string `form:"symbol,optional"`
}

type ListProductsResp {
	RespBase
	data []MarketProduct `json:"data"`
}

// ====================
// K线
// ====================
type GetProductKlineReq {
	categoryCode string `form:"categoryCode"`
	market       string `form:"market"`
	symbol       string `form:"symbol"`
	kType        int64  `form:"kType"`
	endTs        int64  `form:"endTs"`
}

type GetProductKlineResp {
	RespBase
	data []Kline `json:"data"`
}

type SyncProductKlineHistoryReq {
	categoryCode string `json:"categoryCode"`
	market       string `json:"market"`
	symbol       string `json:"symbol"`
	kType        int64  `json:"kType"`
	endTs        int64  `json:"endTs,optional"`
}

type SyncProductKlineHistoryResp {
	RespBase
	syncedCount int64 `json:"syncedCount"`
}

// ====================
// tenant product category
// ====================
type CreateTenantCategoryReq {
	tenantId   int64  `json:"tenantId"`
	categoryId int64  `json:"categoryId"`
	enabled    int64  `json:"enabled"`
	appVisible int64  `json:"appVisible"`
	sort       int64  `json:"sort"`
	remark     string `json:"remark"`
}

type UpdateTenantCategoryReq {
	id         int64  `json:"id"`
	tenantId   int64  `json:"tenantId"`
	enabled    int64  `json:"enabled"`
	appVisible int64  `json:"appVisible"`
	sort       int64  `json:"sort"`
	remark     string `json:"remark"`
}

type BatchUpsertTenantCategoriesReq {
	tenantId int64                `json:"tenantId"`
	data     []TenantCategoryItem `json:"data"`
}

type TenantCategoryItem {
	id         int64  `json:"id"`
	categoryId int64  `json:"categoryId"`
	enabled    int64  `json:"enabled"`
	appVisible int64  `json:"appVisible"`
	sort       int64  `json:"sort"`
	remark     string `json:"remark"`
}

type GetTenantCategoryReq {
	id       int64 `path:"id"`
	tenantId int64 `form:"tenantId"`
}

type GetTenantCategoryResp {
	RespBase
	data MarketTenantCategory `json:"data"`
}

type ListTenantCategoriesReq {
	PageReq
	tenantId      int64 `json:"tenantId,optional"`
	categoryType  int64 `json:"categoryType,optional"`
	enabled       int32 `json:"enabled,optional"` // 0全部 1启用 2禁用
	visibleStatus int32 `json:"visibleStatus,optional"` // 0全部 1显示 2隐藏
}

type ListTenantCategoriesResp {
	RespBase
	data []MarketTenantCategory `json:"data"`
}

// ====================
// tenant product
// ====================
type CreateTenantProductReq {
	tenantId   int64  `json:"tenantId"`
	productId  int64  `json:"productId"`
	enabled    int64  `json:"enabled"`
	appVisible int64  `json:"appVisible"`
	sort       int64  `json:"sort"`
	remark     string `json:"remark"`
}

type UpdateTenantProductReq {
	id          int64  `json:"id"`
	tenantId    int64  `json:"tenantId"`
	enabled     int64  `json:"enabled"`
	appVisible  int64  `json:"appVisible"`
	displayName string `json:"displayName"`
	sort        int64  `json:"sort"`
	remark      string `json:"remark"`
}

type BatchUpsertTenantProductsReq {
	tenantId int64               `json:"tenantId"`
	data     []TenantProductItem `json:"data"`
}

type TenantProductItem {
	id         int64  `json:"id"`
	productId  int64  `json:"productId"`
	enabled    int64  `json:"enabled"`
	appVisible int64  `json:"appVisible"`
	sort       int64  `json:"sort"`
	remark     string `json:"remark"`
}

type GetTenantProductReq {
	id       int64 `path:"id"`
	tenantId int64 `form:"tenantId"`
}

type GetTenantProductResp {
	RespBase
	data MarketTenantProduct `json:"data"`
}

type ListTenantProductsReq {
	PageReq
	tenantId     int64  `form:"tenantId,optional"`
	categoryType int64  `form:"categoryType,optional"`
	market       string `form:"market,optional"`
	keyword      string `form:"keyword,optional"`
	enabled      int32  `form:"enabled,optional"` // 0全部 1启用 2禁用
	appVisible   int32  `form:"appVisible,optional"` // 0全部 1显示 2隐藏
}

type ListTenantProductsResp {
	RespBase
	data []MarketTenantProduct `json:"data"`
}

// ====================
// tenant init
// ====================
type InitTenantMarketDisplayReq {
	tenantId  int64 `json:"tenantId"`
	overwrite int64 `json:"overwrite"` // 是否覆盖已有配置
}

type InitTenantMarketDisplayData {
	categoryCount int64 `json:"categoryCount"`
	productCount  int64 `json:"productCount"`
}

type InitTenantMarketDisplayResp {
	RespBase
	data InitTenantMarketDisplayData `json:"data"`
}

// ====================
// 权威行情来源注册表
// ====================
type AuthorityRegistryData {
	id           int64    `json:"id"`
	authority    string   `json:"authority"`
	providerCode string   `json:"providerCode"`
	producerType string   `json:"producerType"`
	allowedKinds []string `json:"allowedKinds"`
	status       int32    `json:"status"`
	version      int64    `json:"version"`
	createTimes  int64    `json:"createTimes"`
	updateTimes  int64    `json:"updateTimes"`
}

type SetAuthorityRegistryReq {
	id           int64    `json:"id,optional"`
	authority    string   `json:"authority"`
	providerCode string   `json:"providerCode"`
	producerType string   `json:"producerType"`
	allowedKinds []string `json:"allowedKinds"`
	status       int32    `json:"status"`
	version      int64    `json:"version,optional"`
}

type AuthorityRegistryResp {
	RespBase
	data AuthorityRegistryData `json:"data"`
}

type ListAuthorityRegistriesReq {
	PageReq
	authority    string `form:"authority,optional"`
	providerCode string `form:"providerCode,optional"`
	producerType string `form:"producerType,optional"`
	snapshotKind string `form:"snapshotKind,optional"`
	status       int32  `form:"status,optional"`
}

type ListAuthorityRegistriesResp {
	RespBase
	data []AuthorityRegistryData `json:"data"`
}

type PriceFormulaComponent {
	authority    string `json:"authority"`
	snapshotKind string `json:"snapshotKind"`
	categoryCode string `json:"categoryCode,optional"`
	market       string `json:"market,optional"`
	symbol       string `json:"symbol"`
	weight       string `json:"weight" validate:"required,decimal_gte_zero,decimal_65_30"`
}

type CreatePriceFormulaReq {
	formulaNo       string                  `json:"formulaNo"`
	authority       string                  `json:"authority"`
	snapshotKind    string                  `json:"snapshotKind"`
	categoryCode    string                  `json:"categoryCode,optional"`
	market          string                  `json:"market,optional"`
	symbol          string                  `json:"symbol"`
	algorithm       int64                   `json:"algorithm"`
	formulaVersion  string                  `json:"formulaVersion"`
	components      []PriceFormulaComponent `json:"components"`
	maxLookbackMs   int64                   `json:"maxLookbackMs"`
	maxDeviationBps int64                   `json:"maxDeviationBps"`
	minInputCount   int64                   `json:"minInputCount"`
	intervalMs      int64                   `json:"intervalMs"`
	activate        bool                    `json:"activate"`
}

type PriceFormulaReq {
	id int64 `path:"id"`
}

type ChangePriceFormulaStatusReq {
	id     int64 `path:"id"`
	status int32 `json:"status"`
}

type ListPriceFormulasReq {
	PageReq
	authority    string `json:"authority,optional"`
	snapshotKind string `json:"snapshotKind,optional"`
	categoryCode string `json:"categoryCode,optional"`
	market       string `json:"market,optional"`
	symbol       string `json:"symbol,optional"`
	status       int32  `json:"status,optional"`
}

type PriceFormulaData {
	id              int64                   `json:"id"`
	formulaNo       string                  `json:"formulaNo"`
	authority       string                  `json:"authority"`
	snapshotKind    string                  `json:"snapshotKind"`
	categoryCode    string                  `json:"categoryCode"`
	market          string                  `json:"market"`
	symbol          string                  `json:"symbol"`
	algorithm       int64                   `json:"algorithm"`
	formulaVersion  string                  `json:"formulaVersion"`
	components      []PriceFormulaComponent `json:"components"`
	maxLookbackMs   int64                   `json:"maxLookbackMs"`
	maxDeviationBps int64                   `json:"maxDeviationBps"`
	minInputCount   int64                   `json:"minInputCount"`
	intervalMs      int64                   `json:"intervalMs"`
	lastTargetTime  int64                   `json:"lastTargetTime"`
	status          int32                   `json:"status"`
	version         int64                   `json:"version"`
	createTimes     int64                   `json:"createTimes"`
	updateTimes     int64                   `json:"updateTimes"`
}

type PriceFormulaResp {
	RespBase
	data PriceFormulaData `json:"data"`
}

type ListPriceFormulasResp {
	RespBase
	data []PriceFormulaData `json:"data"`
}

type ListSnapshotOutboxReq {
	PageReq
	status     int32  `json:"status,optional"`
	snapshotId string `json:"snapshotId,optional"`
}

type SnapshotOutboxData {
	id               int64  `json:"id"`
	snapshotId       string `json:"snapshotId"`
	status           int32  `json:"status"`
	retryCount       int64  `json:"retryCount"`
	nextRetryAt      int64  `json:"nextRetryAt"`
	redisPublishedAt int64  `json:"redisPublishedAt"`
	eventPublishedAt int64  `json:"eventPublishedAt"`
	lastErrorMsg     string `json:"lastErrorMsg"`
	createTimes      int64  `json:"createTimes"`
	updateTimes      int64  `json:"updateTimes"`
}

type ListSnapshotOutboxResp {
	RespBase
	data []SnapshotOutboxData `json:"data"`
}

type RetrySnapshotOutboxReq {
	id int64 `path:"id"`
}

type RevokeAuthoritativeSnapshotReq {
	snapshotId            string `json:"snapshotId"`
	replacementSnapshotId string `json:"replacementSnapshotId,optional"`
	reason                string `json:"reason"`
}

@server (
	prefix: /admin/market
	group:  market
	jwt:    Jwt
)
service admin {
	// 产品类型列表
	@handler ListCategories
	get /categories (ListCategoriesReq) returns (ListCategoriesResp)

	// 创建产品类型
	@handler CreateCategory
	post /categories (CreateCategoryReq) returns (RespBase)

	// 更新产品类型仅允许更新名称、状态、排序、图标和备注，产品类型不允许修改
	@handler UpdateCategory
	put /categories (UpdateCategoryReq) returns (RespBase)

	// 获取产品类型详情
	@handler GetCategory
	get /categories/:id (GetCategoryReq) returns (GetCategoryResp)

	// 同步类型下的产品
	@handler SyncCategoryProducts
	post /categories/sync-products (SyncCategoryProductsReq) returns (SyncCategoryProductsResp)

	// 获取同步任务状态
	@handler GetSyncTaskStatus
	get /sync-tasks/:taskNo/status (GetSyncTaskStatusReq) returns (GetSyncTaskStatusResp)

	// 产品列表
	@handler ListProducts
	get /products (ListProductsReq) returns (ListProductsResp)

	// 产品
	@handler CreateProduct
	post /products (CreateProductReq) returns (RespBase)

	// 更新产品仅允许更新名称、状态、排序、图标和备注，市场、品种、代码不允许修改
	@handler UpdateProduct
	put /products (UpdateProductReq) returns (RespBase)

	// 获取产品详情
	@handler GetProduct
	get /products/:id (GetProductReq) returns (GetProductResp)

	// K线查看
	@handler GetProductKline
	get /product/kline (GetProductKlineReq) returns (GetProductKlineResp)

	// 从 iTick 获取指定产品历史 K 线并写入 MongoDB
	@handler SyncProductKlineHistory
	post /product/kline/sync-history (SyncProductKlineHistoryReq) returns (SyncProductKlineHistoryResp)

	// 租户产品类型列表
	@handler ListTenantCategories
	get /tenant-categories (ListTenantCategoriesReq) returns (ListTenantCategoriesResp)

	// 租户产品类型
	@handler CreateTenantCategory
	post /tenant-categories (CreateTenantCategoryReq) returns (RespBase)

	// 更新租户产品类型仅允许更新状态、排序和备注，关联的产品类型不允许修改
	@handler UpdateTenantCategory
	put /tenant-categories (UpdateTenantCategoryReq) returns (RespBase)

	// 批量更新租户产品类型，已关联的修改状态、排序和备注，未关联的新增，未提交的删除
	@handler BatchUpsertTenantCategories
	post /tenant-categories/batch (BatchUpsertTenantCategoriesReq) returns (RespBase)

	// 获取租户产品类型详情
	@handler GetTenantCategory
	get /tenant-categories/:id (GetTenantCategoryReq) returns (GetTenantCategoryResp)

	// 租户产品列表
	@handler ListTenantProducts
	get /tenant-products (ListTenantProductsReq) returns (ListTenantProductsResp)

	// 租户产品
	@handler CreateTenantProduct
	post /tenant-products (CreateTenantProductReq) returns (RespBase)

	// 更新租户产品仅允许更新状态、排序和备注，关联的产品不允许修改
	@handler UpdateTenantProduct
	put /tenant-products (UpdateTenantProductReq) returns (RespBase)

	// 批量更新租户产品，已关联的修改状态、排序和备注，未关联的新增，未提交的删除
	@handler BatchUpsertTenantProducts
	post /tenant-products/batch (BatchUpsertTenantProductsReq) returns (RespBase)

	// 获取租户产品详情
	@handler GetTenantProduct
	get /tenant-products/:id (GetTenantProductReq) returns (GetTenantProductResp)

	// 初始化租户展示配置
	@handler InitTenantMarketDisplay
	post /tenant-display/init (InitTenantMarketDisplayReq) returns (InitTenantMarketDisplayResp)

	@handler SetAuthorityRegistry
	post /authorities (SetAuthorityRegistryReq) returns (AuthorityRegistryResp)

	@handler ListAuthorityRegistries
	get /authorities (ListAuthorityRegistriesReq) returns (ListAuthorityRegistriesResp)

	@handler CreatePriceFormula
	post /price-formulas (CreatePriceFormulaReq) returns (PriceFormulaResp)

	@handler GetPriceFormula
	get /price-formulas/:id (PriceFormulaReq) returns (PriceFormulaResp)

	@handler ListPriceFormulas
	get /price-formulas (ListPriceFormulasReq) returns (ListPriceFormulasResp)

	@handler ChangePriceFormulaStatus
	put /price-formulas/:id/status (ChangePriceFormulaStatusReq) returns (RespBase)

	@handler ListSnapshotOutbox
	get /snapshot-outbox (ListSnapshotOutboxReq) returns (ListSnapshotOutboxResp)

	@handler RetrySnapshotOutbox
	post /snapshot-outbox/:id/retry (RetrySnapshotOutboxReq) returns (RespBase)

	@handler RevokeAuthoritativeSnapshot
	post /authoritative-snapshots/revoke (RevokeAuthoritativeSnapshotReq) returns (RespBase)
}

