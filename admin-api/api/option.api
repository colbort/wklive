@server (
	prefix: /admin/option
	group:  option
	jwt:    Jwt
)
service admin {
	@handler CreateContract
	post /contracts (CreateContractReq) returns (CreateContractResp)

	@handler UpdateContract
	post /contracts/update (UpdateContractReq) returns (OptionAdminCommonResp)

	@handler GetContract
	get /contracts/detail (GetContractReq) returns (GetContractResp)

	@handler ListContracts
	get /contracts (ListContractsReq) returns (ListContractsResp)

	@handler UpdateMarket
	post /market/update (UpdateMarketReq) returns (OptionAdminCommonResp)

	@handler GetMarket
	get /market/detail (GetMarketReq) returns (GetMarketResp)

	@handler ListMarketSnapshots
	get /market/snapshots (ListMarketSnapshotsReq) returns (ListMarketSnapshotsResp)

	@handler GetOrder
	get /orders/detail (GetOrderReq) returns (GetOrderResp)

	@handler ListOrders
	get /orders (ListOrdersReq) returns (ListOrdersResp)

	@handler GetTrade
	get /trades/detail (GetTradeReq) returns (GetTradeResp)

	@handler ListTrades
	get /trades (ListTradesReq) returns (ListTradesResp)

	@handler GetPosition
	get /positions/detail (GetPositionReq) returns (GetPositionResp)

	@handler ListPositions
	get /positions (ListPositionsReq) returns (ListPositionsResp)

	@handler GetExercise
	get /exercises/detail (GetExerciseReq) returns (GetExerciseResp)

	@handler ListExercises
	get /exercises (ListExercisesReq) returns (ListExercisesResp)

	@handler RetryExercise
	post /exercises/retry (OptionRetryExerciseReq) returns (OptionAdminCommonResp)

	@handler GetSettlement
	get /settlements/detail (GetSettlementReq) returns (GetSettlementResp)

	@handler ListSettlements
	get /settlements (ListSettlementsReq) returns (ListSettlementsResp)

	@handler GetAccount
	get /accounts/detail (GetAccountReq) returns (GetAccountResp)

	@handler ListAccounts
	get /accounts (ListAccountsReq) returns (ListAccountsResp)

	@handler GetBill
	get /bills/detail (GetBillReq) returns (GetBillResp)

	@handler ListBills
	get /bills (ListBillsReq) returns (ListBillsResp)

	@handler ForceCancelContractOrders
	post /contracts/force-cancel-orders (OptionForceCancelContractOrdersReq) returns (OptionAdminCommonResp)

	@handler RetryAssetInstruction
	post /recovery/asset-instructions/retry (OptionRetryAssetInstructionReq) returns (OptionAdminCommonResp)

	@handler RetrySettlementInstruction
	post /settlements/retry-instruction (OptionRetrySettlementInstructionReq) returns (OptionAdminCommonResp)

	@handler RetryTradeEvent
	post /recovery/trade-events/retry (OptionRetryTradeEventReq) returns (OptionAdminCommonResp)

	@handler ListRiskAccounts
	get /risk/accounts (ListOptionRiskAccountsReq) returns (ListOptionRiskAccountsResp)

	@handler ListLiquidations
	get /risk/liquidations (ListOptionLiquidationsReq) returns (ListOptionLiquidationsResp)

	@handler RetryLiquidation
	post /risk/liquidations/retry (OptionRetryLiquidationReq) returns (OptionAdminCommonResp)
}

