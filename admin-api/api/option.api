type ListOptionRiskAccountsReq {
	PageReq
	tenantId   int64  `form:"tenantId,optional"`
	userId     int64  `form:"userId,optional"`
	accountId  int64  `form:"accountId,optional"`
	settleCoin string `form:"settleCoin,optional"`
	status     int64  `form:"status,optional"`
}

type ListOptionRiskAccountsResp {
	RespBase
	data []OptionRiskAccount `json:"data"`
}

type OptionPortfolioRiskConfig {
	id                     int64  `json:"id"`
	tenantId               int64  `json:"tenantId"`
	settleCoin             string `json:"settleCoin"`
	version                int64  `json:"version"`
	status                 int64  `json:"status"`
	modelMethod            int64  `json:"modelMethod"`
	initialShockRate       string `json:"initialShockRate"`
	maintenanceShockRate   string `json:"maintenanceShockRate"`
	scenarioShocks         string `json:"scenarioShocks"`
	concentrationThreshold string `json:"concentrationThreshold"`
	concentrationAddonRate string `json:"concentrationAddonRate"`
	liquidityAddonRate     string `json:"liquidityAddonRate"`
	effectiveFrom          int64  `json:"effectiveFrom"`
	effectiveUntil         int64  `json:"effectiveUntil"`
	supersedesId           int64  `json:"supersedesId"`
	sourceConfigId         int64  `json:"sourceConfigId"`
	changeReason           string `json:"changeReason"`
	evidenceRef            string `json:"evidenceRef"`
	createdBy              int64  `json:"createdBy"`
	reviewedBy             int64  `json:"reviewedBy"`
	reviewReason           string `json:"reviewReason"`
	reviewedAt             int64  `json:"reviewedAt"`
	createTimes            int64  `json:"createTimes"`
	updateTimes            int64  `json:"updateTimes"`
}

type CreatePortfolioRiskConfigReq {
	tenantId               int64  `json:"tenantId"`
	settleCoin             string `json:"settleCoin" validate:"required,max=16"`
	modelMethod            int64  `json:"modelMethod"`
	initialShockRate       string `json:"initialShockRate"`
	maintenanceShockRate   string `json:"maintenanceShockRate"`
	scenarioShocks         string `json:"scenarioShocks"`
	concentrationThreshold string `json:"concentrationThreshold"`
	concentrationAddonRate string `json:"concentrationAddonRate"`
	liquidityAddonRate     string `json:"liquidityAddonRate"`
	effectiveFrom          int64  `json:"effectiveFrom"`
	changeReason           string `json:"changeReason" validate:"required,max=500"`
	evidenceRef            string `json:"evidenceRef" validate:"required,max=500"`
	sourceConfigId         int64  `json:"sourceConfigId,optional"`
}

type ReviewPortfolioRiskConfigReq {
	tenantId int64  `json:"tenantId"`
	configId int64  `json:"configId"`
	approve  bool   `json:"approve"`
	reason   string `json:"reason" validate:"required,max=500"`
}

type GetPortfolioRiskConfigResp {
	RespBase
	data OptionPortfolioRiskConfig `json:"data"`
}

type ListPortfolioRiskConfigsReq {
	PageReq
	tenantId   int64  `form:"tenantId,optional"`
	settleCoin string `form:"settleCoin,optional"`
	status     int64  `form:"status,optional"`
}

type ListPortfolioRiskConfigsResp {
	RespBase
	data  []OptionPortfolioRiskConfig `json:"data"`
	total int64                       `json:"total"`
}

type OptionInsuranceInventoryExit {
	id                 int64  `json:"id"`
	tenantId           int64  `json:"tenantId"`
	requestNo          string `json:"requestNo"`
	positionId         int64  `json:"positionId"`
	contractId         int64  `json:"contractId"`
	insuranceUserId    int64  `json:"insuranceUserId"`
	insuranceAccountId int64  `json:"insuranceAccountId"`
	quantity           string `json:"quantity"`
	limitPrice         string `json:"limitPrice"`
	status             int64  `json:"status"`
	reason             string `json:"reason"`
	evidenceRef        string `json:"evidenceRef"`
	requestedBy        int64  `json:"requestedBy"`
	reviewedBy         int64  `json:"reviewedBy"`
	reviewReason       string `json:"reviewReason"`
	reviewedAt         int64  `json:"reviewedAt"`
	orderId            int64  `json:"orderId"`
	submittedBy        int64  `json:"submittedBy"`
	submittedAt        int64  `json:"submittedAt"`
	lastErrorMsg       string `json:"lastErrorMsg"`
	createTimes        int64  `json:"createTimes"`
	updateTimes        int64  `json:"updateTimes"`
	orderStatus        int64  `json:"orderStatus"`
	filledQty          string `json:"filledQty"`
	unfilledQty        string `json:"unfilledQty"`
}

type CreateInsuranceInventoryExitReq {
	tenantId    int64  `json:"tenantId"`
	positionId  int64  `json:"positionId"`
	quantity    string `json:"quantity" validate:"required,max=64"`
	limitPrice  string `json:"limitPrice" validate:"required,max=64"`
	reason      string `json:"reason" validate:"required,max=500"`
	evidenceRef string `json:"evidenceRef" validate:"required,max=500"`
}

type ReviewInsuranceInventoryExitReq {
	tenantId int64  `json:"tenantId"`
	exitId   int64  `json:"exitId"`
	approve  bool   `json:"approve"`
	reason   string `json:"reason" validate:"required,max=500"`
}

type ExecuteInsuranceInventoryExitReq {
	tenantId int64 `json:"tenantId"`
	exitId   int64 `json:"exitId"`
}

type GetInsuranceInventoryExitResp {
	RespBase
	data OptionInsuranceInventoryExit `json:"data"`
}

type ListInsuranceInventoryExitsReq {
	PageReq
	tenantId   int64 `form:"tenantId"`
	positionId int64 `form:"positionId,optional"`
	contractId int64 `form:"contractId,optional"`
	status     int64 `form:"status,optional"`
}

type ListInsuranceInventoryExitsResp {
	RespBase
	data  []OptionInsuranceInventoryExit `json:"data"`
	total int64                          `json:"total"`
}

type ListOptionLiquidationsReq {
	PageReq
	tenantId   int64 `form:"tenantId,optional"`
	userId     int64 `form:"userId,optional"`
	accountId  int64 `form:"accountId,optional"`
	contractId int64 `form:"contractId,optional"`
	positionId int64 `form:"positionId,optional"`
	status     int64 `form:"status,optional"`
}

type ListOptionLiquidationsResp {
	RespBase
	data []OptionLiquidation `json:"data"`
}

type OptionRetryLiquidationReq {
	tenantId      int64 `json:"tenantId"`
	liquidationId int64 `json:"liquidationId"`
}

@server (
	prefix: /admin/option
	group:  option
	jwt:    Jwt
)
service admin {
	@handler CreateContract
	post /contracts (CreateContractReq) returns (CreateContractResp)

	@handler UpdateContract
	post /contracts/update (UpdateContractReq) returns (OptionAdminCommonResp)

	@handler GetContract
	get /contracts/detail (GetContractReq) returns (GetContractResp)

	@handler ListContracts
	get /contracts (ListContractsReq) returns (ListContractsResp)

	@handler UpdateMarket
	post /market/update (UpdateMarketReq) returns (OptionAdminCommonResp)

	@handler GetMarket
	get /market/detail (GetMarketReq) returns (GetMarketResp)

	@handler ListMarketSnapshots
	get /market/snapshots (ListMarketSnapshotsReq) returns (ListMarketSnapshotsResp)

	@handler GetOrder
	get /orders/detail (GetOrderReq) returns (GetOrderResp)

	@handler ListOrders
	get /orders (ListOrdersReq) returns (ListOrdersResp)

	@handler ListAdminComboOrders
	get /combo-orders (ListAdminComboOrdersReq) returns (ListAdminComboOrdersResp)

	@handler GetAdminComboOrder
	get /combo-orders/detail (GetAdminComboOrderReq) returns (GetAdminComboOrderResp)

	@handler ForceCancelComboOrder
	post /combo-orders/force-cancel (ForceCancelComboOrderReq) returns (OptionAdminCommonResp)

	@handler GetTrade
	get /trades/detail (GetTradeReq) returns (GetTradeResp)

	@handler ListTrades
	get /trades (ListTradesReq) returns (ListTradesResp)

	@handler GetPosition
	get /positions/detail (GetPositionReq) returns (GetPositionResp)

	@handler ListPositions
	get /positions (ListPositionsReq) returns (ListPositionsResp)

	@handler GetExercise
	get /exercises/detail (GetExerciseReq) returns (GetExerciseResp)

	@handler ListExercises
	get /exercises (ListExercisesReq) returns (ListExercisesResp)

	@handler RetryExercise
	post /exercises/retry (OptionRetryExerciseReq) returns (OptionAdminCommonResp)

	@handler GetSettlement
	get /settlements/detail (GetSettlementReq) returns (GetSettlementResp)

	@handler ListSettlements
	get /settlements (ListSettlementsReq) returns (ListSettlementsResp)

	@handler ListSettlementPrices
	get /settlement-prices (ListSettlementPricesReq) returns (ListSettlementPricesResp)

	@handler CreateSettlementPriceCorrection
	post /settlement-prices/corrections (CreateSettlementPriceCorrectionReq) returns (GetSettlementPriceResp)

	@handler ReviewSettlementPrice
	post /settlement-prices/review (ReviewSettlementPriceReq) returns (GetSettlementPriceResp)

	@handler GetAccount
	get /accounts/detail (GetAccountReq) returns (GetAccountResp)

	@handler ListAccounts
	get /accounts (ListAccountsReq) returns (ListAccountsResp)

	@handler GetBill
	get /bills/detail (GetBillReq) returns (GetBillResp)

	@handler ListBills
	get /bills (ListBillsReq) returns (ListBillsResp)

	@handler ForceCancelContractOrders
	post /contracts/force-cancel-orders (OptionForceCancelContractOrdersReq) returns (OptionAdminCommonResp)

	@handler ReleaseUserKillSwitch
	post /trading-controls/release-kill-switch (OptionReleaseUserKillSwitchReq) returns (OptionAdminCommonResp)

	@handler AdminGetUserTradingControl
	get /trading-controls/detail (AdminGetUserTradingControlReq) returns (AdminGetUserTradingControlResp)

	@handler ListTradingControlEvents
	get /trading-controls/events (ListTradingControlEventsReq) returns (ListTradingControlEventsResp)

	@handler UpsertMMPConfig
	post /mmp/config (UpsertMMPConfigReq) returns (GetMMPConfigResp)

	@handler ResetMMPConfig
	post /mmp/reset (ResetMMPConfigReq) returns (GetMMPConfigResp)

	@handler ListMMPConfigs
	get /mmp/configs (ListMMPConfigsReq) returns (ListMMPConfigsResp)

	@handler CreateTradeCorrection
	post /trade-corrections (CreateTradeCorrectionReq) returns (GetTradeCorrectionResp)

	@handler ReviewTradeCorrection
	post /trade-corrections/review (ReviewTradeCorrectionReq) returns (GetTradeCorrectionResp)

	@handler ListTradeCorrections
	get /trade-corrections (ListTradeCorrectionsReq) returns (ListTradeCorrectionsResp)

	@handler RetryAssetInstruction
	post /recovery/asset-instructions/retry (OptionRetryAssetInstructionReq) returns (OptionAdminCommonResp)

	@handler GetOperationsOverview
	get /operations/overview (GetOperationsOverviewReq) returns (GetOperationsOverviewResp)

	@handler ListAssetInstructions
	get /operations/asset-instructions (ListAssetInstructionsReq) returns (ListAssetInstructionsResp)

	@handler ListReconciliationIssues
	get /operations/reconciliation-issues (ListReconciliationIssuesReq) returns (ListReconciliationIssuesResp)

	@handler CreateTradingCalendar
	post /trading-calendars (CreateTradingCalendarReq) returns (GetTradingCalendarResp)

	@handler ReviewTradingCalendar
	post /trading-calendars/review (ReviewTradingCalendarReq) returns (GetTradingCalendarResp)

	@handler ListTradingCalendars
	get /trading-calendars (ListTradingCalendarsReq) returns (ListTradingCalendarsResp)

	@handler HaltContractTrading
	post /trading-halts (HaltContractTradingReq) returns (GetTradingHaltResp)

	@handler ResumeContractTrading
	post /trading-halts/resume (ResumeContractTradingReq) returns (GetTradingHaltResp)

	@handler ListTradingHalts
	get /trading-halts (ListTradingHaltsReq) returns (ListTradingHaltsResp)

	@handler CreateCorporateAction
	post /corporate-actions (CreateCorporateActionReq) returns (GetCorporateActionResp)

	@handler ReviewCorporateAction
	post /corporate-actions/review (ReviewCorporateActionReq) returns (GetCorporateActionResp)

	@handler ListCorporateActions
	get /corporate-actions (ListCorporateActionsReq) returns (ListCorporateActionsResp)

	@handler ListCorporateActionPositions
	get /corporate-actions/positions (ListCorporateActionPositionsReq) returns (ListCorporateActionPositionsResp)

	@handler CreateContractSeries
	post /contract-series (CreateContractSeriesReq) returns (GetContractSeriesResp)

	@handler ReviewContractSeries
	post /contract-series/review (ReviewContractSeriesReq) returns (GetContractSeriesResp)

	@handler ListContractSeries
	get /contract-series (ListContractSeriesReq) returns (ListContractSeriesResp)

	@handler ListContractSeriesDetails
	get /contract-series/details (ListContractSeriesDetailsReq) returns (ListContractSeriesDetailsResp)

	@handler ReviewContractSeriesLaunch
	post /contract-series/launch-review (ReviewContractSeriesLaunchReq) returns (GetContractSeriesResp)

	@handler RetrySettlementInstruction
	post /settlements/retry-instruction (OptionRetrySettlementInstructionReq) returns (OptionAdminCommonResp)

	@handler ListPhysicalDeliveryUnits
	get /physical-delivery/units (ListPhysicalDeliveryUnitsReq) returns (ListPhysicalDeliveryUnitsResp)

	@handler RetryPhysicalDeliveryUnit
	post /physical-delivery/units/retry (RetryPhysicalDeliveryUnitReq) returns (OptionAdminCommonResp)

	@handler RetryTradeEvent
	post /recovery/trade-events/retry (OptionRetryTradeEventReq) returns (OptionAdminCommonResp)

	@handler ListRiskAccounts
	get /risk/accounts (ListOptionRiskAccountsReq) returns (ListOptionRiskAccountsResp)

	@handler CreatePortfolioRiskConfig
	post /risk/portfolio-configs (CreatePortfolioRiskConfigReq) returns (GetPortfolioRiskConfigResp)

	@handler ReviewPortfolioRiskConfig
	post /risk/portfolio-configs/review (ReviewPortfolioRiskConfigReq) returns (GetPortfolioRiskConfigResp)

	@handler ListPortfolioRiskConfigs
	get /risk/portfolio-configs (ListPortfolioRiskConfigsReq) returns (ListPortfolioRiskConfigsResp)

	@handler CreateInsuranceInventoryExit
	post /risk/insurance-inventory-exits (CreateInsuranceInventoryExitReq) returns (GetInsuranceInventoryExitResp)

	@handler ReviewInsuranceInventoryExit
	post /risk/insurance-inventory-exits/review (ReviewInsuranceInventoryExitReq) returns (GetInsuranceInventoryExitResp)

	@handler ExecuteInsuranceInventoryExit
	post /risk/insurance-inventory-exits/execute (ExecuteInsuranceInventoryExitReq) returns (GetInsuranceInventoryExitResp)

	@handler ListInsuranceInventoryExits
	get /risk/insurance-inventory-exits (ListInsuranceInventoryExitsReq) returns (ListInsuranceInventoryExitsResp)

	@handler ListLiquidations
	get /risk/liquidations (ListOptionLiquidationsReq) returns (ListOptionLiquidationsResp)

	@handler RetryLiquidation
	post /risk/liquidations/retry (OptionRetryLiquidationReq) returns (OptionAdminCommonResp)
}
