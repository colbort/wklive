	takerFeeRate string `json:"takerFeeRate"`
	buyEnabled   int64  `json:"buyEnabled"`
	sellEnabled  int64  `json:"sellEnabled"`
	createTimes  int64  `json:"createTimes"`
	updateTimes  int64  `json:"updateTimes"`
}

type TradeSymbolContract {
	id                     int64  `json:"id"`
