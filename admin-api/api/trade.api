	avgPrice          string `json:"avgPrice"`
	fee               string `json:"fee"`
	feeAsset          string `json:"feeAsset"`
	source            int64  `json:"source"`
	isReduceOnly      int64  `json:"isReduceOnly"` // 是否只减仓：1是 2否
	triggerPrice      string `json:"triggerPrice"`
