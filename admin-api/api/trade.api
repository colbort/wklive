@server (
	prefix: /admin/trade
	group:  trade
	jwt:    Jwt
)
service admin {
	@handler CreateSymbol
	post /symbols (CreateSymbolReq) returns (CommonResp)

	@handler UpdateSymbol
	post /symbols/update (UpdateSymbolReq) returns (CommonResp)

	@handler GetSymbolListAdmin
	get /symbols (GetSymbolListAdminReq) returns (GetSymbolListAdminResp)

	@handler GetSymbolDetailAdmin
	get /symbols/detail (GetSymbolDetailAdminReq) returns (GetSymbolDetailAdminResp)

	@handler SetSpotSymbolConfig
	post /symbols/spot-config (SetSpotSymbolConfigReq) returns (CommonResp)

	@handler SetContractSymbolConfig
	post /symbols/contract-config (SetContractSymbolConfigReq) returns (CommonResp)

	@handler SetSecondsSymbolConfig
	post /symbols/seconds-config (SetSecondsSymbolConfigReq) returns (CommonResp)

	@handler SetSymbolSession
	post /symbols/session (SetSymbolSessionReq) returns (CommonResp)

	@handler SetSymbolLeverageConfig
	post /symbols/leverage-config (SetSymbolLeverageConfigReq) returns (CommonResp)

	@handler GetSymbolLeverageConfig
	get /symbols/leverage-config (GetSymbolLeverageConfigReq) returns (GetSymbolLeverageConfigResp)

	@handler GetSymbolLeverageConfigList
	get /symbols/leverage-configs (GetSymbolLeverageConfigListReq) returns (GetSymbolLeverageConfigListResp)

	@handler GetOrderListAdmin
	get /orders (GetOrderListAdminReq) returns (GetOrderListAdminResp)

	@handler GetOrderDetailAdmin
	get /orders/detail (GetOrderDetailAdminReq) returns (GetOrderDetailAdminResp)

	@handler GetFillListAdmin
	get /fills (GetFillListAdminReq) returns (GetFillListAdminResp)

	@handler GetFillDetailAdmin
	get /fills/detail (GetFillDetailAdminReq) returns (GetFillDetailAdminResp)

	@handler GetPositionListAdmin
	get /positions (GetPositionListAdminReq) returns (GetPositionListAdminResp)

	@handler GetPositionDetailAdmin
	get /positions/detail (GetPositionDetailAdminReq) returns (GetPositionDetailAdminResp)

	@handler GetPositionHistoryListAdmin
	get /position-histories (GetPositionHistoryListAdminReq) returns (GetPositionHistoryListAdminResp)

	@handler GetMarginSnapshotListAdmin
	get /margin-snapshots (GetMarginSnapshotListAdminReq) returns (GetMarginSnapshotListAdminResp)

	@handler GetCancelLogListAdmin
	get /cancel-logs (GetCancelLogListAdminReq) returns (GetCancelLogListAdminResp)

	@handler SetUserTradeLimit
	post /user-trade-limit (SetUserTradeLimitReq) returns (CommonResp)

	@handler SetUserSymbolLimit
	post /user-symbol-limit (SetUserSymbolLimitReq) returns (CommonResp)

	@handler GetUserTradeLimit
	get /user-trade-limit (GetUserTradeLimitReq) returns (GetUserTradeLimitResp)

	@handler GetUserSymbolLimit
	get /user-symbol-limit (GetUserSymbolLimitReq) returns (GetUserSymbolLimitResp)

	@handler SetUserTradeConfig
	post /user-trade-config (SetUserTradeConfigReq) returns (CommonResp)

	@handler GetUserTradeConfig
	get /user-trade-config (GetUserTradeConfigReq) returns (GetUserTradeConfigResp)

	@handler SetContractUserConfig
	post /contract-user-config (SetContractUserConfigReq) returns (CommonResp)

	@handler GetContractUserConfig
	get /contract-user-config (GetContractUserConfigReq) returns (GetContractUserConfigResp)

	@handler GetRiskOrderCheckLogList
	get /risk-order-check-logs (GetRiskOrderCheckLogListReq) returns (GetRiskOrderCheckLogListResp)

	@handler SetUserLeverageConfig
	post /user-leverage-config (SetUserLeverageConfigReq) returns (CommonResp)

	@handler GetUserLeverageConfig
	get /user-leverage-config (GetUserLeverageConfigReq) returns (GetUserLeverageConfigResp)

	@handler GetTradeEventList
	get /events (GetTradeEventListReq) returns (GetTradeEventListResp)

	@handler GetTradeEventDetail
	get /events/detail (GetTradeEventDetailReq) returns (GetTradeEventDetailResp)

	@handler RetryTradeEvent
	post /events/retry (RetryTradeEventReq) returns (CommonResp)

	@handler SetContractRiskLimitTier
	post /risk-tiers (SetContractRiskLimitTierReq) returns (CommonResp)

	@handler GetContractRiskLimitTierList
	get /risk-tiers (GetContractRiskLimitTierListReq) returns (GetContractRiskLimitTierListResp)

	@handler GetFundingBatchList
	get /funding/batches (GetFundingBatchListReq) returns (GetFundingBatchListResp)

	@handler GetFundingSettlementList
	get /funding/settlements (GetFundingSettlementListReq) returns (GetFundingSettlementListResp)

	@handler GetDeliveryBatchList
	get /delivery/batches (GetDeliveryBatchListReq) returns (GetDeliveryBatchListResp)

	@handler GetDeliverySettlementList
	get /delivery/settlements (GetDeliverySettlementListReq) returns (GetDeliverySettlementListResp)

	@handler GetLiquidationList
	get /liquidations (GetLiquidationListReq) returns (GetLiquidationListResp)

	@handler GetAccountLiquidationList
	get /account-liquidations (GetAccountLiquidationListReq) returns (GetAccountLiquidationListResp)

	@handler GetAccountLiquidationDetail
	get /account-liquidations/detail (GetAccountLiquidationDetailReq) returns (GetAccountLiquidationDetailResp)

	@handler RetryAccountLiquidation
	post /account-liquidations/retry (RetryAccountLiquidationReq) returns (CommonResp)

	@handler GetSecondsPriceSnapshotList
	get /seconds/price-snapshots (GetSecondsPriceSnapshotListReq) returns (GetSecondsPriceSnapshotListResp)

	@handler GetAssetReservationList
	get /operations/asset-reservations (GetAssetReservationListReq) returns (GetAssetReservationListResp)

	@handler GetSettlementInstructionList
	get /operations/settlement-instructions (GetSettlementInstructionListReq) returns (GetSettlementInstructionListResp)

	@handler RetrySettlementInstruction
	post /operations/settlement-instructions/retry (RetrySettlementInstructionReq) returns (CommonResp)

	@handler GetContractReconciliationIssueList
	get /operations/reconciliation-issues (GetContractReconciliationIssueListReq) returns (GetContractReconciliationIssueListResp)

	@handler IgnoreContractReconciliationIssue
	post /operations/reconciliation-issues/ignore (IgnoreContractReconciliationIssueReq) returns (CommonResp)

	@handler SetInsuranceFundAccount
	post /insurance-fund/accounts (SetInsuranceFundAccountReq) returns (CommonResp)

	@handler GetInsuranceFundAccountList
	get /insurance-fund/accounts (GetInsuranceFundAccountListReq) returns (GetInsuranceFundAccountListResp)

	@handler GetMarketSnapshotList
	get /market-snapshots (GetMarketSnapshotListReq) returns (GetMarketSnapshotListResp)
}
