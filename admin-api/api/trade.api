	version           int64  `json:"version"`
	secondsDirection  int64  `json:"secondsDirection"`
	durationSeconds   int64  `json:"durationSeconds"`
	createTimes       int64  `json:"createTimes"`
	updateTimes       int64  `json:"updateTimes"`
}

