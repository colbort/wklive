# Copy to production-readiness.env and fill it with approvals and evidence.
# Do not place passwords, API keys, access tokens, or other credentials here.

PRODUCTION_PRICE_SOURCE_IDS="source-a,source-b,source-c"
PRICE_SOURCE_CREDENTIALS_APPROVED=false
PRICE_SOURCE_LICENSE_APPROVED=false
PRODUCTION_CATEGORY_CODE=crypto
PRODUCTION_MARKET=BA
PRODUCTION_PRICE_SYMBOL=BTCUSDT
PRODUCTION_PERPETUAL_SYMBOL=BTCUSDT-PERP
PRODUCTION_DELIVERY_SYMBOL=BTCUSDT-20260925

DELIVERY_ALGORITHM=MEDIAN
DELIVERY_SOURCE_WEIGHTS="1,1,1"
DELIVERY_MAX_DEVIATION_BPS=200
# Must be a whole number of seconds and match the delivery contract window.
DELIVERY_LOCK_WINDOW_MS=30000
DELIVERY_FORMULA_VERSION=delivery-v1
HISTORICAL_REPLAY_REPORT=/absolute/path/to/price-replay-report.json
HISTORICAL_REPLAY_REPORT_SHA256=

ALERT_PLATFORM=
ALERT_ONCALL_TEAM=
ALERT_ESCALATION_POLICY=
ALERT_TEST_REPORT=/absolute/path/to/alert-delivery-test.md
ALERT_TEST_REPORT_SHA256=

PRODUCTION_TENANT_ID=0
PRODUCTION_SETTLEMENT_COIN=USDT
FUND_ACCOUNT_PERMISSION_APPROVED=false
FUND_ACCOUNT_APPROVER=
LIQUIDATION_ENABLE_WINDOW=
LIQUIDATION_ROLLBACK_PLAN=/absolute/path/to/liquidation-rollback-plan.md
LIQUIDATION_ROLLBACK_PLAN_SHA256=

DR_RPO_MINUTES=0
DR_RTO_MINUTES=0
DR_BACKUP_ENCRYPTION=
DR_OFFSITE_LOCATION=
DR_EXERCISE_REPORT=/absolute/path/to/dr-exercise-report.md
DR_EXERCISE_REPORT_SHA256=
