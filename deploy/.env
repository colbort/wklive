MYSQL_ROOT_PASSWORD=123456
# `./deploy.sh data` defaults to the host MySQL through host.docker.internal.
# Override these values when the existing MySQL is on another host or uses a
# non-root account. MYSQL_DSN, when set, takes precedence over all fields below.
MYSQL_EXTERNAL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=wklive
# MYSQL_DSN=user:password@tcp(host:3306)/wklive?charset=utf8mb4&parseTime=true&loc=Local&multiStatements=true
MONGO_ROOT_PASSWORD=openIM123
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
# Keep the default for Compose etcd; set a container-reachable URL for an existing external etcd.
ETCD_ENDPOINT=http://host.docker.internal:2379
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AcceptanceAdmin!2026
LIQUIDITY_ADMIN_USERNAME=liquidityadmin
LIQUIDITY_ADMIN_PASSWORD=replace-liquidity-password
KAFKA_PARTITIONS=1
TZ=Asia/Hong_Kong
DR_BACKUP_BUCKET_NAME=exv-wklive-dr-backup
DR_BACKUP_SOURCE_DB=wklive
DR_BACKUP_RECIPIENT_CERT=/Users/sky/local/go/src/wklive/deploy/secrets/dr-recovery-recipient-cert.pem
DR_BACKUP_RECIPIENT_KEY=/Users/sky/local/go/src/wklive/deploy/secrets/dr-recovery-private-key.pem
DR_BACKUP_RECIPIENT_KEY_PASSPHRASE_FILE=/Users/sky/local/go/src/wklive/deploy/secrets/dr-recovery-key-passphrase
DR_BACKUP_KEY_ID=wklive-dr-interim-cert-883f34296159e59d
DR_BACKUP_OPERATOR_ACCOUNT=dr_operator
DR_BACKUP_REVIEWER_ACCOUNT=production_reviewer
DR_BACKUP_RETENTION_DAYS=30
DR_BACKUP_USE_COMPOSE_CLIENT=true
DR_BACKUP_USE_SYSTEM_OBJECT_STORAGE=true
DR_BACKUP_OBJECT_PREFIX=wklive/mysql
DR_BACKUP_MIN_FREE_KB=8388608
DR_BACKUP_RESTORE_MIN_FREE_KB=12582912
