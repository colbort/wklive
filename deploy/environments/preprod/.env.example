# Copy this file to deploy/environments/preprod/.env, chmod 600, and replace
# every replace-* value. Never commit the resulting .env file.

PREPROD_PROJECT_NAME=wklive-preprod
PREPROD_IMAGE_REGISTRY=wklive
RELEASE_TAG=replace-with-git-sha
TZ=Asia/Hong_Kong

# One isolated tenant receives the pre-production BTCUSDT/ETHUSDT baseline.
# The id and code are immutable after first initialization.
PREPROD_TENANT_ID=1
PREPROD_TENANT_CODE=preprod
PREPROD_TENANT_NAME=预发布租户

# Infrastructure credentials. Use unique values containing only letters,
# numbers, dot, underscore and dash so they remain safe in DSNs and config
# rendering. Passwords are validated by preprod.sh before Docker is invoked.
MYSQL_ROOT_PASSWORD=replace-mysql-root-password
MYSQL_APP_USER=wklive_app
MYSQL_APP_PASSWORD=replace-mysql-app-password
MONGO_ROOT_PASSWORD=replace-mongo-root-password
REDIS_PASSWORD=replace-redis-password
JWT_ACCESS_SECRET=replace-jwt-access-secret-at-least-32-characters

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-admin-password-at-least-20-characters
LIQUIDITY_ADMIN_USERNAME=liquidityadmin
LIQUIDITY_ADMIN_PASSWORD=replace-liquidity-password-at-least-20-characters

# Admin request encryption is required in pre-production. The wrap key must be
# exactly 32 ASCII bytes. The RSA private key and token paths must be absolute,
# readable by Docker, and chmod 600 or 400.
ADMIN_REQUEST_ENCRYPTION_MODE=REQUIRED
ADMIN_SESSION_WRAP_KEY=replace-exactly-32-ascii-bytes-x
ADMIN_ALLOWED_ORIGIN=https://preprod-admin.example.com
PREPROD_ADMIN_RSA_PRIVATE_KEY_FILE=/secure/wklive/preprod/admin-api-private.pem
PREPROD_ITICK_TOKEN_FILE=/secure/wklive/preprod/itick_token
PREPROD_OPERATORS_ENV_FILE=/secure/wklive/preprod/production-operators.env

# Host exposure is loopback-only by default. Put a TLS reverse proxy in front
# of these ports. Setting 0.0.0.0 requires PREPROD_ALLOW_PUBLIC_BIND=true and
# an independently reviewed firewall/TLS configuration.
PREPROD_BIND_ADDRESS=127.0.0.1
PREPROD_ALLOW_PUBLIC_BIND=false
PREPROD_PAYMENT_API_PORT=13333
PREPROD_APP_API_PORT=15555
PREPROD_CHAT_ADMIN_API_PORT=16666
PREPROD_CHAT_API_PORT=17777
PREPROD_ADMIN_API_PORT=18888
PREPROD_LIQUIDITY_ADMIN_API_PORT=19999
PREPROD_OPTION_METRICS_PORT=19105
PREPROD_ADMIN_UI_PORT=18080
PREPROD_APP_WEB_PORT=18081
PREPROD_CHAT_ADMIN_UI_PORT=18082
PREPROD_LIQUIDITY_ADMIN_UI_PORT=18083

KAFKA_PARTITIONS=3

# true: build the tagged release images from the checked-out source before up.
# false: use pre-built images pulled from PREPROD_IMAGE_REGISTRY.
PREPROD_BUILD_LOCAL=true
