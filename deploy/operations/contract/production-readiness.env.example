# Copy to production-readiness.env and fill it with approvals and evidence.
# Do not place passwords, API keys, access tokens, or other credentials here.

# Each Authority must be enabled for FINAL_QUOTE and map to a distinct provider_code.
# Different WS/REST channels from the same provider do not count as independent sources.
PRODUCTION_PRICE_SOURCE_IDS="source-a,source-b,source-c"
PRODUCTION_PRICE_SOURCE_MARKETS="market-a,market-b,market-c"
# Use PUBLIC_NO_CREDENTIALS only when every declared Authority is a verified
# PUBLIC_REST producer. Otherwise leave blank and require credentials approval.
PRICE_SOURCE_ACCESS_MODE=
PRICE_SOURCE_CREDENTIALS_APPROVED=false
PRICE_SOURCE_LICENSE_APPROVED=false
PRODUCTION_CATEGORY_CODE=crypto
PRODUCTION_MARKET=BA
PRODUCTION_PRICE_SYMBOL=BTCUSDT
PRODUCTION_PERPETUAL_SYMBOL=BTCUSDT-PERP
PRODUCTION_DELIVERY_SYMBOL=BTCUSDT-20260925

INDEX_ALGORITHM=MEDIAN
INDEX_SOURCE_WEIGHTS="1,1,1"
INDEX_MAX_DEVIATION_BPS=200
INDEX_FORMULA_VERSION=index-v1
PERPETUAL_PRICE_AUTHORITY=perpetual-source
PERPETUAL_PRICE_MARKET=perpetual-market
MARK_FORMULA_VERSION=production-mark-v3
MARK_MAX_BASIS_BPS=200
MARK_CURRENT_WEIGHT=1
MARK_PREVIOUS_WEIGHT=4
FUNDING_FORMULA_VERSION=funding-v1
PRICE_FORMULA_INTERVAL_MS=1000

DELIVERY_ALGORITHM=MEDIAN
DELIVERY_SOURCE_WEIGHTS="1,1,1"
DELIVERY_MAX_DEVIATION_BPS=200
# Must be a whole number of seconds and match the delivery contract window.
DELIVERY_LOCK_WINDOW_MS=30000
DELIVERY_FORMULA_VERSION=delivery-v1
HISTORICAL_REPLAY_REPORT=/absolute/path/to/price-replay-report.json
HISTORICAL_REPLAY_REPORT_SHA256=
HISTORICAL_REPLAY_PRODUCTION_APPROVAL_REF=

ALERT_PLATFORM=
ALERT_ONCALL_TEAM=
ALERT_ESCALATION_POLICY=
ALERT_TEST_REPORT=/absolute/path/to/alert-delivery-test.md
ALERT_TEST_REPORT_SHA256=
ALERT_TEST_PRODUCTION_APPROVAL_REF=

# System identities are checked against sys_user/sys_role/sys_role_menu.
CONTRACT_ONCALL_ACCOUNT=contract_oncall
INSURANCE_OPERATOR_ACCOUNT=insurance_operator
DR_OPERATOR_ACCOUNT=dr_operator
DELIVERY_OPERATOR_ACCOUNT=delivery_operator
PRODUCTION_REVIEWER_ACCOUNT=production_reviewer
PRODUCTION_APPROVER_ACCOUNT=production_approver

PRODUCTION_TENANT_ID=0
PRODUCTION_SETTLEMENT_COIN=USDT
# Approved minimum available balance for the production insurance fund.
# Must be a positive DECIMAL(36,18); 0 deliberately keeps the gate closed.
INSURANCE_FUND_MIN_AVAILABLE=0
FUND_ACCOUNT_PERMISSION_APPROVED=false
FUND_ACCOUNT_APPROVER=
LIQUIDATION_ENABLE_WINDOW=
LIQUIDATION_ROLLBACK_PLAN=/absolute/path/to/liquidation-rollback-plan.md
LIQUIDATION_ROLLBACK_PLAN_SHA256=
LIQUIDATION_ROLLBACK_PRODUCTION_APPROVAL_REF=

DR_RPO_MINUTES=0
DR_RTO_MINUTES=0
DR_BACKUP_ENCRYPTION=
DR_OFFSITE_LOCATION=
DR_EXERCISE_REPORT=/absolute/path/to/dr-exercise-report.md
DR_EXERCISE_REPORT_SHA256=
DR_EXERCISE_PRODUCTION_APPROVAL_REF=
