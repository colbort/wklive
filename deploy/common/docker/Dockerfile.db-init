ARG GO_VERSION=1.26.4
FROM golang:${GO_VERSION}-alpine AS builder

WORKDIR /src
COPY deploy/common/dbinit/ .
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -mod=vendor -trimpath -ldflags="-s -w" -o /out/db-init .
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -mod=vendor -trimpath -ldflags="-s -w" -o /out/contract-readiness ./cmd/contract-readiness
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -mod=vendor -trimpath -ldflags="-s -w" -o /out/object-storage ./cmd/object-storage
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -mod=vendor -trimpath -ldflags="-s -w" -o /out/delivery-preflight ./cmd/delivery-preflight

FROM alpine:3.23 AS database-release

WORKDIR /source
COPY init.sql ./init.sql
COPY services ./services
COPY deploy/environments/preprod/data/bootstrap.sql /release/profiles/preprod/bootstrap.sql
RUN set -eu; \
    mkdir -p /release; \
    cp init.sql /release/init.sql; \
    find services -type f -name '*.sql' -print | while IFS= read -r source; do \
      destination="/release/$source"; \
      mkdir -p "$(dirname "$destination")"; \
      cp "$source" "$destination"; \
    done; \
    cd /release; \
    find . -type f -name '*.sql' -print | LC_ALL=C sort | while IFS= read -r sql_file; do \
      sha256sum "$sql_file"; \
    done > MANIFEST.sha256

FROM alpine:3.23
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /out/db-init /usr/local/bin/db-init
COPY --from=builder /out/contract-readiness /usr/local/bin/contract-readiness
COPY --from=builder /out/object-storage /usr/local/bin/object-storage
COPY --from=builder /out/delivery-preflight /usr/local/bin/delivery-preflight
COPY --from=database-release /release /release
ENV WORKSPACE=/release
ENTRYPOINT ["/usr/local/bin/db-init"]
