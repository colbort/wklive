# Pin the multi-architecture index rather than an architecture-specific
# manifest. Docker selects the native linux/amd64 or linux/arm64 image for the
# builder, so Apple Silicon does not fall back to instruction-set emulation.
ARG ALPINE_IMAGE=alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
FROM ${ALPINE_IMAGE}

RUN apk add --no-cache beanstalkd=1.13-r0 \
    && mkdir -p /var/lib/beanstalkd \
    && chown nobody:nobody /var/lib/beanstalkd

USER nobody
EXPOSE 11300

ENTRYPOINT ["beanstalkd"]
CMD ["-l", "0.0.0.0", "-p", "11300", "-b", "/var/lib/beanstalkd", "-f", "0"]
