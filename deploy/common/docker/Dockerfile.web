ARG NODE_IMAGE=node:20-alpine
FROM ${NODE_IMAGE} AS builder

ARG UI_DIR
WORKDIR /workspace/${UI_DIR}

COPY app-packages/ /workspace/app-packages/
RUN npm ci --prefix /workspace/app-packages --omit=dev --ignore-scripts

COPY ${UI_DIR}/package.json ${UI_DIR}/package-lock.json ./
RUN npm ci --ignore-scripts

COPY ${UI_DIR}/ ./
RUN npm run build

FROM nginx:1.28-alpine

ARG UI_DIR

RUN rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p /usr/share/nginx/html \
    && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run

COPY --from=builder /workspace/${UI_DIR}/dist/ /usr/share/nginx/html/
COPY deploy/common/config/nginx-spa.conf.template /etc/nginx/templates/default.conf.template

ENV NGINX_ENVSUBST_FILTER="^(API_UPSTREAM|API_PATH_PREFIX)$"

HEALTHCHECK --interval=10s --timeout=3s --retries=12 --start-period=5s \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

EXPOSE 8080
