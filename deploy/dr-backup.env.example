# 复制到 Git 忽略的 deploy/secrets/dr-backup.env，执行时设置：
# DR_BACKUP_ENV_FILE=/absolute/path/to/deploy/secrets/dr-backup.env ./deploy.sh contract-dr-backup

MYSQL_ROOT_PASSWORD=replace-mysql-password
DR_BACKUP_SOURCE_DB=wklive
DR_BACKUP_RECIPIENT_CERT=/absolute/path/to/kms-or-hsm-recipient-cert.pem
# 仅供三个 contract-dr-backup-local-* 本地验收命令使用；生产上传主机不应持有恢复私钥。
# DR_BACKUP_RECIPIENT_KEY=/absolute/path/to/encrypted-local-verification-key.pem
# DR_BACKUP_RECIPIENT_KEY_PASSPHRASE_FILE=/absolute/path/to/protected-passphrase-file
DR_BACKUP_KEY_ID=replace-kms-key-id-or-certificate-thumbprint
DR_BACKUP_OPERATOR_ACCOUNT=dr_operator
DR_BACKUP_REVIEWER_ACCOUNT=production_reviewer
DR_BACKUP_RETENTION_DAYS=30

# 当前 Compose MySQL 可直接使用容器内匹配版本的 mysqldump；外部 MySQL 可设为
# false，并通过 MYSQLDUMP_CLIENT_BIN 指定与服务端兼容的客户端。
DR_BACKUP_USE_COMPOSE_CLIENT=true

# 默认从管理后台的系统配置 OBJECT_STORAGE.minio 读取 endpoint、bucket 和访问密钥。
# 灾备必须使用独立私有桶，不能复用系统附件桶。这里只配置专用桶和对象前缀，
# 避免在部署目录重复保存 endpoint 和对象存储密钥。
DR_BACKUP_USE_SYSTEM_OBJECT_STORAGE=true
DR_BACKUP_BUCKET_NAME=replace-dedicated-private-backup-bucket
DR_BACKUP_OBJECT_PREFIX=wklive/mysql

# 本地全库恢复会将临时 MySQL 数据目录绑定到受保护的宿主临时目录；默认至少要求
# 12 GiB 可用空间，不使用生产 MySQL Volume。
# DR_BACKUP_RESTORE_MIN_FREE_KB=12582912

# 仅当明确不使用系统配置时，才设置以下 S3-compatible 参数。访问密钥必须来自
# 主机角色、workload identity 或 Git 忽略的 secret 文件，禁止提交到仓库。
# DR_BACKUP_USE_SYSTEM_OBJECT_STORAGE=false
# DR_BACKUP_DESTINATION_URI=s3://replace-offsite-bucket/wklive/mysql
# DR_BACKUP_S3_ENDPOINT=https://object-storage.example.internal
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional tool locations.
# MYSQL_CLIENT_BIN=/opt/homebrew/opt/mysql-client/bin/mysql
# MYSQLDUMP_CLIENT_BIN=/absolute/path/to/server-compatible/mysqldump
# MYSQLBINLOG_CLIENT_BIN=/absolute/path/to/server-compatible/mysqlbinlog
# OPENSSL_CLIENT_BIN=/opt/homebrew/bin/openssl
# AWS_CLIENT_BIN=/absolute/path/to/aws
