  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "start:services:all",
        "type": "shell",
        "command": "set -e\n# Level 0: no RPC dependencies\ncd \"${workspaceFolder:services}/chat\" && go run chat.go &\nsleep 2\ncd \"${workspaceFolder:services}/asset\" && go run asset.go &\nsleep 2\n# Level 1: system -> chat; option/payment/staking -> asset\ncd \"${workspaceFolder:services}/system\" && go run system.go &\nsleep 2\ncd \"${workspaceFolder:services}/option\" && go run option.go &\nsleep 2\ncd \"${workspaceFolder:services}/payment\" && go run payment.go &\nsleep 2\ncd \"${workspaceFolder:services}/staking\" && go run staking.go &\nsleep 2\n# Level 2: user -> system; itick -> system + option\ncd \"${workspaceFolder:services}/user\" && go run user.go &\nsleep 2\ncd \"${workspaceFolder:services}/itick\" && go run itick.go &\nsleep 2\n# Level 3: trade -> asset + itick\ncd \"${workspaceFolder:services}/trade\" && go run trade.go &\nwait",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "group": "services"
        }
      },
    ]
  },
