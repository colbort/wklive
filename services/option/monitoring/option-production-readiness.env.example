# Copy to option-production-readiness.env outside the repository and replace every
# placeholder. Do not store credentials, API tokens or personal phone numbers here.

OPTION_PRODUCTION_TENANT_ID=0
OPTION_RELEASE_COMMIT=
OPTION_PRODUCT_APPROVAL_REF=
OPTION_RISK_APPROVAL_REF=
OPTION_CLEARING_APPROVAL_REF=
OPTION_COMPLIANCE_APPROVAL_REF=

# All feature flags are mandatory. Keep unapproved features false.
OPTION_SELLER_TRADING_ENABLED=false
OPTION_PORTFOLIO_MARGIN_ENABLED=false
OPTION_PHYSICAL_DELIVERY_ENABLED=false
OPTION_COMPLEX_ORDERS_ENABLED=false
OPTION_PUBLIC_MARKET_ENABLED=false
OPTION_GREEKS_DEPENDENT_FEATURES_ENABLED=false

# These cannot be set true until real production/preproduction evidence exists.
# Refers to scope=2 full-funds conservation, not the built-in scope=1 wallet-mirror heartbeat.
OPTION_ZERO_DIFF_HEARTBEAT_ENABLED=false
OPTION_PRODUCTION_METRICS_TARGET_VERIFIED=false
# Must be reachable from the machine/network running the production gate.
OPTION_METRICS_URL=http://option-rpc:9105/metrics
OPTION_INSURANCE_FLOW_SIGN_RESOLVED=false
OPTION_BACKSTOP_LIMIT_APPROVED=false

# Each evidence path must reference a non-empty immutable report. Generate the hash
# with `shasum -a 256 FILE` (macOS) or `sha256sum FILE` (Linux).
OPTION_RELEASE_SIGNOFF=/absolute/path/to/option-production-readiness-signoff.md
OPTION_RELEASE_SIGNOFF_SHA256=
OPTION_MIGRATION_REPORT=/absolute/path/to/option-migration-report.md
OPTION_MIGRATION_REPORT_SHA256=
OPTION_ASSET_E2E_REPORT=/absolute/path/to/option-asset-e2e-report.md
OPTION_ASSET_E2E_REPORT_SHA256=
OPTION_FAILURE_INJECTION_REPORT=/absolute/path/to/option-failure-injection-report.md
OPTION_FAILURE_INJECTION_REPORT_SHA256=
OPTION_CAPACITY_REPORT=/absolute/path/to/option-capacity-report.md
OPTION_CAPACITY_REPORT_SHA256=
OPTION_ALERT_DELIVERY_REPORT=/absolute/path/to/option-alert-delivery-test.md
OPTION_ALERT_DELIVERY_REPORT_SHA256=
OPTION_DAILY_RECONCILIATION_REPORT=/absolute/path/to/option-daily-reconciliation.md
OPTION_DAILY_RECONCILIATION_REPORT_SHA256=
OPTION_DATABASE_AUDIT_REPORT=/absolute/path/to/option-database-audit-report.md
OPTION_DATABASE_AUDIT_REPORT_SHA256=
OPTION_ONCALL_ROSTER_REPORT=/absolute/path/to/option-oncall-roster.md
OPTION_ONCALL_ROSTER_REPORT_SHA256=

# Use the rendered production configs, not the examples in this directory.
OPTION_PROMETHEUS_CONFIG=/absolute/path/to/rendered-prometheus.yml
OPTION_PROMETHEUS_CONFIG_SHA256=
OPTION_ALERTMANAGER_CONFIG=/absolute/path/to/rendered-alertmanager.yml
OPTION_ALERTMANAGER_CONFIG_SHA256=

# Required when OPTION_SELLER_TRADING_ENABLED=true.
OPTION_INSURANCE_SIGN_RESOLUTION_REPORT=/absolute/path/to/insurance-sign-resolution.md
OPTION_INSURANCE_SIGN_RESOLUTION_REPORT_SHA256=

# Required only when the corresponding feature flag is true.
OPTION_MODEL_VALIDATION_REPORT=/absolute/path/to/option-portfolio-model-validation.md
OPTION_MODEL_VALIDATION_REPORT_SHA256=
OPTION_PHYSICAL_DELIVERY_APPROVAL=/absolute/path/to/option-physical-delivery-approval.md
OPTION_PHYSICAL_DELIVERY_APPROVAL_SHA256=
OPTION_COMPLEX_ORDER_E2E_REPORT=/absolute/path/to/option-complex-order-e2e.md
OPTION_COMPLEX_ORDER_E2E_REPORT_SHA256=
OPTION_PUBLIC_MARKET_PROBE_REPORT=/absolute/path/to/option-public-market-probes.md
OPTION_PUBLIC_MARKET_PROBE_REPORT_SHA256=
OPTION_GREEKS_THRESHOLD_APPROVAL=/absolute/path/to/option-greeks-threshold-approval.md
OPTION_GREEKS_THRESHOLD_APPROVAL_SHA256=
