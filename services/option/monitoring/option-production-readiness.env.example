# Copy to option-production-readiness.env outside the repository and replace every
# placeholder. Keep every OPTION_* key exactly once; unknown, duplicate or missing
# keys are rejected. Disabled conditional evidence keys remain present with an empty
# value. Do not store credentials, API tokens or personal phone numbers here.

OPTION_PRODUCTION_TENANT_ID=0
OPTION_RELEASE_COMMIT=
OPTION_PRODUCT_APPROVAL_REF=
OPTION_RISK_APPROVAL_REF=
OPTION_CLEARING_APPROVAL_REF=
OPTION_COMPLIANCE_APPROVAL_REF=

# All feature flags are mandatory. Keep unapproved features false.
OPTION_SELLER_TRADING_ENABLED=false
# Independent from seller trading. Keep false until OPT-P0-007 and the
# filled platform-backstop approval are both complete.
OPTION_PLATFORM_BACKSTOP_ENABLED=false
# Exact Asset policy observed in the approval, target-environment BST report and
# final pre-open read-only query. These are evidence bindings; Asset still selects
# the highest currently effective approved version at runtime.
OPTION_PLATFORM_BACKSTOP_POLICY_ID=0
OPTION_PLATFORM_BACKSTOP_POLICY_VERSION=0
OPTION_PORTFOLIO_MARGIN_ENABLED=false
OPTION_PHYSICAL_DELIVERY_ENABLED=false
OPTION_COMPLEX_ORDERS_ENABLED=false
OPTION_PUBLIC_MARKET_ENABLED=false
OPTION_GREEKS_DEPENDENT_FEATURES_ENABLED=false
OPTION_MMP_ENABLED=false
OPTION_AMERICAN_EXERCISE_ENABLED=false
OPTION_INSURANCE_INVENTORY_EXIT_ENABLED=false

# Mandatory in every production run. This exact rendered Option YAML is
# hash-bound below and must match every ProductScope release flag above. The
# verifier rejects duplicate/missing declarations, sections and keys.
OPTION_PRODUCT_SCOPE_RUNTIME_CONFIG=/absolute/path/to/rendered-option.yaml
OPTION_PRODUCT_SCOPE_RUNTIME_CONFIG_SHA256=

# These cannot be set true until real production/preproduction evidence exists.
# Refers to scope=2 full-funds conservation, not the built-in scope=1 wallet-mirror heartbeat.
OPTION_ZERO_DIFF_HEARTBEAT_ENABLED=false
OPTION_PRODUCTION_METRICS_TARGET_VERIFIED=false
# Must be reachable from the machine/network running the production gate.
OPTION_METRICS_URL=http://option-rpc:9105/metrics
OPTION_INSURANCE_FLOW_SIGN_RESOLVED=false
OPTION_BACKSTOP_LIMIT_APPROVED=false

# Required and hash-checked only when OPTION_PLATFORM_BACKSTOP_ENABLED=true.
# This is the exact rendered Option runtime YAML, not the repository example.
OPTION_PLATFORM_BACKSTOP_RUNTIME_CONFIG=/absolute/path/to/rendered-option.yaml
OPTION_PLATFORM_BACKSTOP_RUNTIME_CONFIG_SHA256=

# Required and hash-checked when insurance inventory exit is enabled. This must
# be the exact rendered Option runtime YAML, with all five hard limits positive.
OPTION_INSURANCE_INVENTORY_EXIT_RUNTIME_CONFIG=/absolute/path/to/rendered-option.yaml
OPTION_INSURANCE_INVENTORY_EXIT_RUNTIME_CONFIG_SHA256=

# Each evidence path must reference a non-empty immutable report. Generate the hash
# with `shasum -a 256 FILE` (macOS) or `sha256sum FILE` (Linux). Reports without a
# dedicated template must copy docs/templates/option-production-evidence-report.md
# and retain OPTION_EVIDENCE_STATUS: DRAFT until the real execution is approved.
OPTION_RELEASE_SIGNOFF=/absolute/path/to/option-production-readiness-signoff.md
OPTION_RELEASE_SIGNOFF_SHA256=
# Filled option-contract-launch-bundle.md. A single-contract release still uses
# the bundle with one machine-readable OPTION_LAUNCH_CONTRACT record; every record
# references an approved, identity-bound per-contract checklist. The verifier checks
# count, uniqueness, tenant/release identity and every referenced file hash.
OPTION_LAUNCH_CHECKLIST=/absolute/path/to/option-contract-launch-bundle.md
OPTION_LAUNCH_CHECKLIST_SHA256=
# Filled option-contract-set-reconciliation.md. It binds the approved bundle to
# the actual target-environment export and final publication/client contract set.
OPTION_CONTRACT_SET_RECONCILIATION=/absolute/path/to/option-contract-set-reconciliation.md
OPTION_CONTRACT_SET_RECONCILIATION_SHA256=
# Filled option-operations-input-checklist.md with all applicable external values
# and six-party approval; the repository DRAFT is never valid production evidence.
OPTION_OPERATIONS_INPUT_CHECKLIST=/absolute/path/to/option-operations-input-checklist.md
OPTION_OPERATIONS_INPUT_CHECKLIST_SHA256=
OPTION_MIGRATION_REPORT=/absolute/path/to/option-migration-report.md
OPTION_MIGRATION_REPORT_SHA256=
OPTION_ASSET_E2E_REPORT=/absolute/path/to/option-asset-e2e-report.md
OPTION_ASSET_E2E_REPORT_SHA256=
OPTION_FAILURE_INJECTION_REPORT=/absolute/path/to/option-failure-injection-report.md
OPTION_FAILURE_INJECTION_REPORT_SHA256=
OPTION_CAPACITY_REPORT=/absolute/path/to/option-capacity-report.md
OPTION_CAPACITY_REPORT_SHA256=
# Filled repository templates; production mode requires their APPROVED markers.
OPTION_ORCHESTRATOR_TAKEOVER_REPORT=/absolute/path/to/option-orchestrator-takeover-report.md
OPTION_ORCHESTRATOR_TAKEOVER_REPORT_SHA256=
OPTION_BEANSTALK_CAPACITY_REPORT=/absolute/path/to/option-beanstalk-capacity-rto-report.md
OPTION_BEANSTALK_CAPACITY_REPORT_SHA256=
OPTION_ALERT_DELIVERY_REPORT=/absolute/path/to/option-alert-delivery-test.md
OPTION_ALERT_DELIVERY_REPORT_SHA256=
OPTION_DAILY_RECONCILIATION_REPORT=/absolute/path/to/option-daily-reconciliation.md
OPTION_DAILY_RECONCILIATION_REPORT_SHA256=
# Filled option-database-security-audit-acceptance.md; production mode requires OPTION_DATABASE_AUDIT_STATUS: APPROVED.
OPTION_DATABASE_AUDIT_REPORT=/absolute/path/to/option-database-audit-report.md
OPTION_DATABASE_AUDIT_REPORT_SHA256=
OPTION_ONCALL_ROSTER_REPORT=/absolute/path/to/option-oncall-roster.md
OPTION_ONCALL_ROSTER_REPORT_SHA256=
# Required for every production contract because TRADING admission requires a
# positive, approved per-contract Greeks freshness threshold.
OPTION_GREEKS_THRESHOLD_APPROVAL=/absolute/path/to/option-greeks-threshold-approval.md
OPTION_GREEKS_THRESHOLD_APPROVAL_SHA256=

# Required for every production contract. The repository acceptance report is
# a technical baseline only; these must identify the actual venue/calendar,
# authoritative annual source, signed four-eyes approval and preproduction run.
OPTION_TRADING_CALENDAR_APPROVAL=/absolute/path/to/trading-calendar-approval.md
OPTION_TRADING_CALENDAR_APPROVAL_SHA256=
OPTION_TRADING_CALENDAR_ANNUAL_REVIEW=/absolute/path/to/trading-calendar-annual-review.md
OPTION_TRADING_CALENDAR_ANNUAL_REVIEW_SHA256=
OPTION_TRADING_CALENDAR_PREPRODUCTION_REPORT=/absolute/path/to/trading-calendar-preproduction-e2e.md
OPTION_TRADING_CALENDAR_PREPRODUCTION_REPORT_SHA256=

# Use the rendered production configs, not the examples in this directory.
OPTION_PROMETHEUS_CONFIG=/absolute/path/to/rendered-prometheus.yml
OPTION_PROMETHEUS_CONFIG_SHA256=
OPTION_ALERTMANAGER_CONFIG=/absolute/path/to/rendered-alertmanager.yml
OPTION_ALERTMANAGER_CONFIG_SHA256=

# Required when OPTION_SELLER_TRADING_ENABLED=true.
OPTION_INSURANCE_LEDGER_APPROVAL=/absolute/path/to/option-insurance-fund-ledger-production-approval.md
OPTION_INSURANCE_LEDGER_APPROVAL_SHA256=
OPTION_INSURANCE_SIGN_RESOLUTION_REPORT=/absolute/path/to/insurance-sign-resolution.md
OPTION_INSURANCE_SIGN_RESOLUTION_REPORT_SHA256=

# Required when OPTION_PLATFORM_BACKSTOP_ENABLED=true. Approval alone does not
# replace BST-001 through BST-012 runtime evidence.
OPTION_PLATFORM_BACKSTOP_APPROVAL=/absolute/path/to/option-platform-backstop-policy-approval.md
OPTION_PLATFORM_BACKSTOP_APPROVAL_SHA256=
OPTION_PLATFORM_BACKSTOP_E2E_REPORT=/absolute/path/to/option-platform-backstop-e2e.md
OPTION_PLATFORM_BACKSTOP_E2E_REPORT_SHA256=

# Required only when the corresponding feature flag is true.
OPTION_MODEL_VALIDATION_REPORT=/absolute/path/to/option-portfolio-model-validation.md
OPTION_MODEL_VALIDATION_REPORT_SHA256=
# Copy the generic evidence report for this version-switch E2E.
OPTION_PORTFOLIO_VERSION_SWITCH_E2E_REPORT=/absolute/path/to/option-portfolio-version-switch-e2e.md
OPTION_PORTFOLIO_VERSION_SWITCH_E2E_REPORT_SHA256=
# Filled option-physical-delivery-default-policy-approval.md.
OPTION_PHYSICAL_DELIVERY_APPROVAL=/absolute/path/to/option-physical-delivery-approval.md
OPTION_PHYSICAL_DELIVERY_APPROVAL_SHA256=
# Filled complex-order-readiness.md, including target-environment E2E and signatures.
OPTION_COMPLEX_ORDER_E2E_REPORT=/absolute/path/to/option-complex-order-e2e.md
OPTION_COMPLEX_ORDER_E2E_REPORT_SHA256=
# Filled public-market-readiness.md, including target gateway/CDN probes and signatures.
OPTION_PUBLIC_MARKET_PROBE_REPORT=/absolute/path/to/option-public-market-probes.md
OPTION_PUBLIC_MARKET_PROBE_REPORT_SHA256=
# Required when MMP is enabled. Filled option-mmp-readiness.md with target-environment
# batch cancellation, Asset release, recovery, monitoring and approvals.
OPTION_MMP_E2E_REPORT=/absolute/path/to/option-mmp-readiness.md
OPTION_MMP_E2E_REPORT_SHA256=
# Required when American early exercise is enabled. Filled aggregate report covering
# every approved American contract and linking its per-contract expiry control record.
OPTION_AMERICAN_EXERCISE_E2E_REPORT=/absolute/path/to/option-american-exercise-readiness.md
OPTION_AMERICAN_EXERCISE_E2E_REPORT_SHA256=
# Filled option-insurance-inventory-exit-approval.md.
OPTION_INSURANCE_INVENTORY_EXIT_APPROVAL=/absolute/path/to/option-insurance-inventory-exit-approval.md
OPTION_INSURANCE_INVENTORY_EXIT_APPROVAL_SHA256=
# Filled option-insurance-inventory-exit-execution-record.md.
OPTION_INSURANCE_INVENTORY_EXIT_E2E_REPORT=/absolute/path/to/option-insurance-inventory-exit-e2e.md
OPTION_INSURANCE_INVENTORY_EXIT_E2E_REPORT_SHA256=
